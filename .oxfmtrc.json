{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"jsdoc": {},
	"quoteProps": "consistent",
	"printWidth": 100,
	"semi": false,
	"singleAttributePerLine": true,
	"singleQuote": true,
	"useTabs": true,
	"trailingComma": "all",
	"sortImports": {
		"internalPattern": ["#src/*"],
		"newlinesBetween": true
	},
	"sortPackageJson": {
		"sortScripts": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/coverage/**",
		"packages/oxlint-config/anti-slop/**",
		"anti-slop/**",
		"packs/**",
		"pnpm-lock.yaml",
		"flake.lock"
	]
}
