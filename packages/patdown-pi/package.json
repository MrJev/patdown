{
	"name": "@patdown/pi",
	"version": "0.5.0",
	"description": "Pi extension that steers write/edit against patdown rules before they hit disk",
	"keywords": [
		"pi-package"
	],
	"homepage": "https://github.com/tyler-dot-earth/patdown",
	"bugs": {
		"url": "https://github.com/tyler-dot-earth/patdown/issues"
	},
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tyler-dot-earth/patdown.git",
		"directory": "packages/patdown-pi"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist",
		"src"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#src/*": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"test": "./src/*.ts",
			"node": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"test": "./dist/index.js",
			"node": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node ../../scripts/warn-direct-package-task.mjs build && tsc -p tsconfig.build.json",
		"check": "node ../../scripts/warn-direct-package-task.mjs check && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
		"clean": "rm -rf dist coverage",
		"format": "oxfmt --write .",
		"format:check": "node ../../scripts/warn-direct-package-task.mjs format:check && oxfmt --check .",
		"lint": "node ../../scripts/warn-direct-package-task.mjs lint && oxlint --disable-nested-config -c ./oxlint.config.ts --tsconfig ./tsconfig.app.json .",
		"prepack": "node ../../scripts/copy-package-license.mjs",
		"test": "node ../../scripts/warn-direct-package-task.mjs test && vitest run",
		"typecheck": "node ../../scripts/warn-direct-package-task.mjs typecheck && tsc -p tsconfig.app.json --incremental --tsBuildInfoFile typecheck.app.tsbuildinfo && tsc -p tsconfig.vitest.json --incremental --tsBuildInfoFile typecheck.vitest.tsbuildinfo"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@patdown/rules": "workspace:*",
		"effect": "catalog:effect",
		"patdown": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@patdown/oxlint-config": "workspace:*",
		"@patdown/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"pi": {
		"extensions": [
			"./src/patdown-pi-extension.ts"
		]
	}
}
